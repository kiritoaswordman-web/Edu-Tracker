<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎓About EduTrack</title>
    <link rel="stylesheet" href="/styles/about.css">
</head>
<body>

    <!-- Navbar -->
    <header class="navbar">
        <a href="/" class="logo">Edu<span>Track</span></a>

        <nav>
            <a href="/">Home</a>
            <a href="/about" class="active">About</a>
            <a href="/#features">Features</a>
            <a href="/student/login" class="login-btn">Student Login</a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <span class="tag">ABOUT EDUTRACK</span>

            <h1>
                Helping Every Student
                <span>Learn and Grow.</span>
            </h1>

            <p>
                EduTrack is a student learning platform that connects
                teachers and students. Teachers can share important
                topics, while students can access learning materials
                and track their academic progress.
            </p>

            <a href="/student_log" class="primary-btn">
                Get Started →
            </a>
        </div>

        <div class="hero-illustration">
            <div class="circle"></div>
            <div class="book">📚</div>
            <div class="cap">🎓</div>
            <div class="floating-card">
                <span>✓</span>
                <div>
                    <strong>Keep Learning</strong>
                    <small>One topic at a time</small>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about-section">
        <div class="section-heading">
            <span class="tag">WHO WE ARE</span>
            <h2>Learning Works Better <span>Together.</span></h2>
            <p>
                Our goal is to make academic information easier
                to access and learning easier to organize.
            </p>
        </div>

        <div class="cards">
            <div class="about-card">
                <div class="card-icon purple">🎯</div>
                <h3>Our Mission</h3>
                <p>
                    To help students find important topics and
                    academic information shared by their teachers.
                </p>
            </div>

            <div class="about-card">
                <div class="card-icon blue">🚀</div>
                <h3>Our Vision</h3>
                <p>
                    To create a supportive learning environment
                    where students can stay focused and organized.
                </p>
            </div>

            <div class="about-card">
                <div class="card-icon green">🤝</div>
                <h3>Our Values</h3>
                <p>
                    We value consistency, collaboration,
                    accessible education, and student growth.
                </p>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features" id="features">
        <div class="features-content">
            <span class="tag">WHY EDUTRACK?</span>

            <h2>Everything You Need to Stay <span>On Track.</span></h2>

            <p>
                EduTrack brings useful learning tools into one place,
                helping teachers guide students and helping students
                organize their studies.
            </p>

            <div class="feature-item">
                <span>✓</span>
                <div>
                    <h4>Important Topics</h4>
                    <p>View topics shared by your teacher.</p>
                </div>
            </div>

            <div class="feature-item">
                <span>✓</span>
                <div>
                    <h4>Student Dashboard</h4>
                    <p>Access your academic information in one place.</p>
                </div>
            </div>

            <div class="feature-item">
                <span>✓</span>
                <div>
                    <h4>Teacher Support</h4>
                    <p>Teachers can organize and share learning topics.</p>
                </div>
            </div>

            <div class="feature-item">
                <span>✓</span>
                <div>
                    <h4>Performance Tracking</h4>
                    <p>Keep track of academic progress when data is available.</p>
                </div>
            </div>
        </div>

        <div class="feature-art">
            <div class="dashboard-card">
                <div class="dashboard-top">
                    <span></span><span></span><span></span>
                </div>

                <h3>Your Learning Journey</h3>
                <p>Small steps. Big progress.</p>

                <div class="progress">
                    <div style="width: 85%"></div>
                </div>

                <div class="progress">
                    <div style="width: 65%"></div>
                </div>

                <div class="progress">
                    <div style="width: 92%"></div>
                </div>

                <div class="topic">
                    <span>✦</span>
                    <div>
                        <strong>Important Topic</strong>
                        <small>Shared by your teacher</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call To Action -->
    <section class="cta">
        <h2>Ready to Start Learning?</h2>
        <p>
            Log in to your EduTrack account and continue
            your learning journey.
        </p>
        <a href="/student_log" class="cta-btn">
            Open Student Portal →
        </a>
    </section>

    <!-- Footer -->
    <footer>
        <a href="/" class="logo">Edu<span>Track</span></a>
        <p>Learn. Track. Grow.</p>
        <small>
            © <%= new Date().getFullYear() %> EduTrack.
            Keep learning, one topic at a time.
        </small>
    </footer>

</body>
</html>
