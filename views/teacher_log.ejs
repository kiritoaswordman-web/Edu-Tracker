<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎓EduTrack - Teacher Login</title>


    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <link rel="stylesheet" href="/styles/login.css">
</head>

<body>

    <div class="Teacher_log">

        <div class="logo">
            <span class="material-symbols-outlined logo-icon">
                school
            </span>
            <h1>EduTrack</h1>
        </div>


        <div class="heading">
            <h2>Teacher Login</h2>
            <p>
                Login to manage students and<br>
                give important topics
            </p>
        </div>


        <form action="/teacher/login" method="post">


            <div class="input-box">
                <span class="material-symbols-outlined">
                    person
                </span>

                <input type="email" name="email" placeholder="Email address" autocomplete="username" required
                    id="Teacher_log_email">
            </div>


            <div class="input-box">
                <span class="material-symbols-outlined">badge</span>
                <input type="number" name="teacherId" placeholder="Teacher ID" min="1" required id="Teacher_log_id">
            </div>

            <div class="input-box">
                <span class="material-symbols-outlined">
                    lock
                </span>

                <input type="password" name="password" placeholder="Password" autocomplete="current-password" required
                    id="Teacher_log_password">
            </div>


            <button type="submit" class="login-btn">
                Login
            </button>

            <div class="forgot">
                <a href="/forgot-password">Forgot Password?</a>
            </div>

        </form>


        <div class="footer">
            Don't have an account?
            <a href="/teacher_register">Register</a>
        </div>

    </div>

</body>

</html>