<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>🎓EduTrack | Student Registration</title>
    <link rel="stylesheet" href="/styles/login.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f6f7fc;
            min-height: 100vh;
            display: grid;
            place-items: center;
            margin: 0
        }

        .card {
            background: #fff;
            width: min(440px, 92vw);
            padding: 32px;
            border-radius: 20px;
            box-shadow: 0 18px 60px #25244a12
        }

        .brand {
            color: #6352d6;
            font-size: 23px;
            font-weight: 800
        }

        .card h1 {
            font-size: 25px;
            margin: 20px 0 6px
        }

        .muted {
            color: #777d93;
            font-size: 13px;
            line-height: 1.6
        }

        .field {
            display: block;
            margin: 15px 0;
            font-size: 12px;
            font-weight: 700;
            color: #555a73
        }

        .field input {
            display: block;
            width: 100%;
            box-sizing: border-box;
            margin-top: 7px;
            padding: 13px;
            border: 1px solid #e1e3ed;
            border-radius: 9px;
            font-size: 14px
        }

        .submit {
            width: 100%;
            padding: 13px;
            border: 0;
            border-radius: 9px;
            background: #6756d9;
            color: #fff;
            font-weight: 700;
            cursor: pointer
        }

        .foot {
            font-size: 13px;
            margin-top: 18px;
            text-align: center
        }

        .foot a {
            color: #6756d9
        }
    </style>
</head>

<body>
    <main class="card"><a href="/" class="brand">EduTrack</a>
        <h1>Create student account</h1>
        <p class="muted">Your teacher must add your roll number before you can register. Your branch and year will be
            matched automatically.</p>
        <form action="/student/register" method="post"><label class="field">Full name<input name="name" required
                    autocomplete="name" placeholder="Enter your full name"></label><label class="field">Teacher-approved
                roll number<input name="rollNumber" required placeholder="Enter your roll number"></label><label
                class="field">Email address<input type="email" name="email" required autocomplete="email"
                    placeholder="you@example.com"></label><label class="field">Create password<input type="password"
                    name="password" minlength="8" required autocomplete="new-password"
                    placeholder="At least 8 characters"></label><button class="submit" type="submit">Register account
                →</button></form>
        <p class="foot">Already registered? <a href="/student_log">Student login</a></p>
    </main>
</body>

</html>